# ---------------------------------------------------------------------------
# PRIVATE DATA — never commit these.
# odometer_state.json contains every priced message, real session IDs and
# your actual spend. budget.json contains live per-session costs.
# ---------------------------------------------------------------------------
odometer_state.json
budget.json
grace_claims.json
grace_claims.json.*
events.jsonl
models-*.json
tui-*.json
switch-*.json
abort-*.json
stop-tui-*.json
preferences.json
launch-suppressed.json
*.log
*.log.previous
*.csv
opencode_cost_*.csv

# Local user config (may contain private provider names / rates)
config.json
prices.local.json
prices.*.local.json

# ---------------------------------------------------------------------------
# Build artefacts
# ---------------------------------------------------------------------------
/build/*
!/build/appicon.png
!/build/windows/
/build/windows/*
!/build/windows/icon.ico
!/build/windows/info.json
!/build/windows/wails.exe.manifest
/dist/
*.spec.bak
*.exe

# build/appicon.png and build/windows/* are Wails build INPUTS (icon, manifest,
# version info), not outputs, so they must be tracked or the icon is lost.
# All other build contents are local outputs, smoke data or backups.

# frontend/dist is SOURCE, not a build artefact: it is the hand-written UI
# embedded by //go:embed all:frontend/dist. A bare "dist/" rule also matched it
# and would have published a repository that cannot compile.
!frontend/dist/
!frontend/dist/**

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
